"use client"

import { AnimatePresence, motion, useReducedMotion } from "motion/react"
import {
  ChevronDown,
  ChevronRight,
  Mic,
  Paperclip,
  Phone,
  Search,
  Send,
  X,
} from "lucide-react"
import {
  useEffect,
  useId,
  useRef,
  useState,
  type CSSProperties,
  type ReactNode,
} from "react"
import styles from "./xinliu-home-experience.module.css"
import { XinliuReferencePanel } from "./xinliu-reference-panel"

const SCREEN = "/images/page7/phone-screenshot.webp"
const CLEAN_BACKGROUND = "/images/page7/figma-home/clean-background.webp"
const PETAL_SHELL = "/images/page7/figma-home/petal-shell.svg"
const PETAL_CONTOUR =
  "M219.662 363.256C195.461 354.932 122.86 286.256 107.734 243.594C91.6007 199.892 101.684 143.703 128.91 121.851C166.219 92.7162 273.105 92.7162 310.414 121.851C337.639 143.703 347.723 199.892 331.589 243.594C316.464 286.256 243.862 354.932 219.662 363.256Z"
const EASE = [0.22, 1, 0.36, 1] as const
const EXIT_EASE = [0.4, 0, 1, 1] as const

type PetalId =
  | "code"
  | "translate"
  | "call"
  | "write"
  | "document"
  | "knowledge"

const PETALS = [
  {
    id: "code",
    label: "写代码",
    icon: "/images/page7/figma-home/icon-code.svg",
    artLeft: "33.97%",
    artTop: "2.45%",
    rotation: 0,
    labelLeft: "50%",
    labelTop: "10.13%",
    polygon:
      "polygon(33.33% 2.4%, 66.67% 2.4%, 66.67% 12%, 57.33% 40%, 45.73% 40%, 33.33% 12%)",
  },
  {
    id: "translate",
    label: "翻译",
    icon: "/images/page7/figma-home/icon-translate.svg",
    artLeft: "8.03%",
    artTop: "17.42%",
    rotation: -60,
    labelLeft: "21.6%",
    labelTop: "25.07%",
    polygon:
      "polygon(4.67% 14%, 33.33% 12%, 45.73% 40%, 42.67% 48%, 2.67% 48%, 1.07% 34%)",
  },
  {
    id: "call",
    label: "打电话",
    icon: "/images/page7/figma-home/icon-call.svg",
    artLeft: "59.48%",
    artTop: "17.18%",
    rotation: 60,
    labelLeft: "78.67%",
    labelTop: "25.07%",
    polygon:
      "polygon(66.67% 12%, 95.33% 14%, 98.93% 34%, 97.33% 48%, 60.27% 48%, 57.33% 40%)",
  },
  {
    id: "write",
    label: "写作",
    icon: "/images/page7/figma-home/icon-write.svg",
    artLeft: "8.03%",
    artTop: "47.21%",
    rotation: -120,
    labelLeft: "21.6%",
    labelTop: "58.4%",
    polygon:
      "polygon(2.67% 49.33%, 42.67% 49.33%, 45.73% 57.33%, 33.33% 88%, 4.67% 86%, 1.07% 66.67%)",
  },
  {
    id: "document",
    label: "读文档",
    icon: "/images/page7/figma-home/icon-document.svg",
    artLeft: "59.48%",
    artTop: "47.21%",
    rotation: 120,
    labelLeft: "78.67%",
    labelTop: "58.4%",
    polygon:
      "polygon(57.33% 57.33%, 60.27% 49.33%, 97.33% 49.33%, 98.93% 66.67%, 95.33% 86%, 66.67% 88%)",
  },
  {
    id: "knowledge",
    label: "知识库",
    icon: "/images/page7/figma-home/icon-knowledge.svg",
    artLeft: "34.04%",
    artTop: "62.45%",
    rotation: 180,
    labelLeft: "50%",
    labelTop: "76.13%",
    polygon:
      "polygon(45.73% 57.33%, 57.33% 57.33%, 66.67% 88%, 66.67% 97.6%, 33.33% 97.6%, 33.33% 88%)",
  },
] as const

const PETAL_COLLAPSE: Record<PetalId, { x: `${number}%`; y: `${number}%` }> = {
  code: { x: "0%", y: "6%" },
  translate: { x: "4.4%", y: "3.4%" },
  call: { x: "-4.4%", y: "3.4%" },
  write: { x: "4.4%", y: "-3.4%" },
  document: { x: "-4.4%", y: "-3.4%" },
  knowledge: { x: "0%", y: "-6%" },
}

const PANEL_DRAFTS: Record<PetalId, string> = {
  code: "创建一个带筛选与数据卡片的移动端看板",
  translate:
    "Please confirm whether tomorrow afternoon's meeting time works for you.",
  call: "帮我预约今晚 7 点的双人位，并记录确认结果",
  write: "写一篇新品发布文案，语气简洁、有力量",
  document: "总结文档的关键结论、风险与下一步行动",
  knowledge: "对比首页两版方案的主要差异，并标注信息来源",
}

const PANEL_INPUT_HEIGHT = 24
const PANEL_CARD_HEIGHT: Record<PetalId, `${number}cqw`> = {
  code: "97cqw",
  translate: "70cqw",
  call: "111cqw",
  write: "88cqw",
  document: "88cqw",
  knowledge: "98cqw",
}

type PetalOrigin = { x: number; y: number; width: number; height: number }

export function XinliuHomeExperience() {
  const reduceMotion = Boolean(useReducedMotion())
  const screenRef = useRef<HTMLDivElement>(null)
  const triggerRef = useRef<HTMLButtonElement | null>(null)
  const [hovered, setHovered] = useState<PetalId | null>(null)
  const [pointerHovered, setPointerHovered] = useState<PetalId | null>(null)
  const [selected, setSelected] = useState<PetalId | null>(null)
  const [origin, setOrigin] = useState<PetalOrigin | null>(null)
  const activePetal = PETALS.find((petal) => petal.id === selected) ?? null

  useEffect(() => {
    const closeOnEscape = (event: KeyboardEvent) => {
      if (event.key === "Escape") setSelected(null)
    }

    window.addEventListener("keydown", closeOnEscape)
    return () => window.removeEventListener("keydown", closeOnEscape)
  }, [])

  return (
    <div
      ref={screenRef}
      className="relative h-full w-full overflow-hidden"
      style={{ containerType: "inline-size" }}
      data-slide-interactive="true"
      data-petal-state={selected ?? "idle"}
      data-petal-hovered={hovered ?? "none"}
    >
      <img
        src={SCREEN}
        alt="心流移动端首页最终方案"
        className="absolute inset-0 block h-full w-full object-cover select-none"
        draggable={false}
      />

      <motion.img
        src={CLEAN_BACKGROUND}
        alt=""
        aria-hidden="true"
        className="pointer-events-none absolute inset-0 z-[1] block h-full w-full object-cover select-none"
        draggable={false}
        style={{
          WebkitMaskImage:
            "linear-gradient(to bottom, transparent 19.8%, black 22.1%, black 69.2%, transparent 72.2%)",
          maskImage:
            "linear-gradient(to bottom, transparent 19.8%, black 22.1%, black 69.2%, transparent 72.2%)",
          willChange: "opacity, filter",
        }}
        animate={{
          opacity: selected ? 1 : 0,
          filter: "brightness(1) saturate(1)",
        }}
        transition={
          selected
            ? {
                duration: reduceMotion ? 0 : 0.2,
                delay: reduceMotion ? 0 : 0.025,
                ease: EASE,
              }
            : {
                duration: reduceMotion ? 0 : 0.22,
                delay: reduceMotion ? 0 : 0.13,
                ease: EASE,
              }
        }
      />

      <PetalAmbientLight
        active={!selected}
        pointerHovered={pointerHovered}
        reduceMotion={reduceMotion}
      />

      <div
        className="absolute inset-x-0 z-[2] overflow-hidden"
        style={{ top: "22.46%", height: "46.5261%" }}
      >
        <AnimatePresence>
          {selected &&
            PETALS.map((petal, index) => (
              <motion.div
                key={petal.id}
                aria-hidden="true"
                className="pointer-events-none absolute inset-0"
                style={{
                  clipPath: petal.polygon,
                  transformOrigin: "50% 50%",
                  willChange: "transform, opacity",
                }}
                initial={{ opacity: 1, scale: 1, x: "0%", y: "0%" }}
                animate={{
                  opacity: 0,
                  scale: reduceMotion ? 1 : 0.97,
                  x: reduceMotion ? "0%" : PETAL_COLLAPSE[petal.id].x,
                  y: reduceMotion ? "0%" : PETAL_COLLAPSE[petal.id].y,
                }}
                exit={{ opacity: 0 }}
                transition={{
                  duration: reduceMotion ? 0 : 0.24,
                  delay: reduceMotion ? 0 : 0.035 + index * 0.006,
                  ease: EXIT_EASE,
                }}
              >
                <img
                  src={SCREEN}
                  alt=""
                  className="absolute left-0 block w-full max-w-none object-cover select-none"
                  style={{ top: "-48.274%", height: "214.9331%" }}
                  draggable={false}
                />
              </motion.div>
            ))}
        </AnimatePresence>

        <div
          aria-hidden="true"
          className="pointer-events-none absolute inset-0"
        >
          {PETALS.map((petal) => (
            <PetalArtwork
              key={petal.id}
              petal={petal}
              highlighted={hovered === petal.id}
              reduceMotion={reduceMotion}
            />
          ))}
        </div>

        <div
          className="absolute inset-0"
          style={{ pointerEvents: selected ? "none" : "auto" }}
          aria-hidden={selected ? "true" : undefined}
          inert={selected !== null}
        >
          {PETALS.map((petal) => (
            <button
              key={petal.id}
              type="button"
              aria-label={`打开${petal.label}`}
              className="absolute inset-0 cursor-pointer border-0 bg-transparent p-0 outline-none"
              style={{ clipPath: petal.polygon }}
              onMouseEnter={() => {
                setHovered(petal.id)
                setPointerHovered(petal.id)
              }}
              onMouseLeave={() => {
                setHovered((current) => (current === petal.id ? null : current))
                setPointerHovered((current) =>
                  current === petal.id ? null : current
                )
              }}
              onFocus={() => setHovered(petal.id)}
              onBlur={() =>
                setHovered((current) => (current === petal.id ? null : current))
              }
              onClick={(event) => {
                const screen = screenRef.current
                if (!screen) return
                triggerRef.current = event.currentTarget
                setOrigin({
                  x:
                    (Number.parseFloat(petal.labelLeft) / 100) *
                    screen.clientWidth,
                  y:
                    (0.2246 +
                      (0.465261 * (Number.parseFloat(petal.labelTop) + 8)) /
                        100) *
                    screen.clientHeight,
                  width: screen.clientWidth,
                  height: screen.clientHeight,
                })
                setHovered(null)
                setPointerHovered(null)
                setSelected(petal.id)
              }}
            />
          ))}
        </div>
      </div>

      <AnimatePresence
        mode="wait"
        onExitComplete={() =>
          triggerRef.current?.focus({ preventScroll: true })
        }
      >
        {activePetal && origin && (
          <CapabilitySheet
            key={activePetal.id}
            petal={activePetal}
            reduceMotion={reduceMotion}
            origin={origin}
            onClose={() => setSelected(null)}
          />
        )}
      </AnimatePresence>
    </div>
  )
}

function PetalAmbientLight({
  active,
  pointerHovered,
  reduceMotion,
}: {
  active: boolean
  pointerHovered: PetalId | null
  reduceMotion: boolean
}) {
  const [pageVisible, setPageVisible] = useState(true)

  useEffect(() => {
    const updateVisibility = () => setPageVisible(!document.hidden)
    updateVisibility()
    document.addEventListener("visibilitychange", updateVisibility)
    return () =>
      document.removeEventListener("visibilitychange", updateVisibility)
  }, [])

  if (reduceMotion) return null

  const running = active && pageVisible
  const carouselRunning = running && !pointerHovered
  const hoverPetal = PETALS.find((petal) => petal.id === pointerHovered)

  return (
    <>
      <motion.div
        aria-hidden="true"
        className={styles.ambientLight}
        data-petal-light={running ? "flowing" : "paused"}
        style={
          {
            "--light-play-state": running ? "running" : "paused",
          } as CSSProperties
        }
        initial={false}
        animate={{ opacity: active ? 1 : 0 }}
        transition={{ duration: 0.2, delay: active ? 0.18 : 0, ease: EASE }}
      >
        <div className={styles.lightField}>
          <div className={styles.lightRiver} />
          <div className={styles.shadowRiver} />
          <div className={styles.warmReflection} />
        </div>
        {PETALS.map((petal) => (
          <div
            key={petal.id}
            className={styles.petalLight}
            style={
              {
                left: petal.artLeft,
                top: petal.artTop,
                transform: `rotate(${petal.rotation}deg)`,
                // Follow the physical circle, independently of the button order.
                "--light-phase": `${-((petal.rotation + 360) % 360) / 30}s`,
              } as CSSProperties
            }
          >
            <div className={styles.petalMask}>
              <div className={styles.surfaceLight} />
              <div className={styles.surfaceShade} />
            </div>
          </div>
        ))}
      </motion.div>
      <motion.div
        aria-hidden="true"
        className={styles.capabilityLight}
        data-capability-carousel={carouselRunning ? "playing" : "paused"}
        style={
          {
            "--light-play-state": carouselRunning ? "running" : "paused",
          } as CSSProperties
        }
        initial={false}
        animate={{ opacity: active && !pointerHovered ? 1 : 0 }}
        transition={{
          duration: 0.2,
          delay: active && !pointerHovered ? 0.18 : 0,
          ease: EASE,
        }}
      >
        <div className={styles.outerOrbitMask} data-flower-orbit="outer">
          <div className={styles.outerOrbitSweep} />
        </div>
      </motion.div>
      <AnimatePresence>
        {active && hoverPetal && (
          <motion.div
            key={hoverPetal.id}
            aria-hidden="true"
            className={styles.hoverLight}
            data-petal-hover-sweep={hoverPetal.id}
            style={
              {
                "--light-play-state": running ? "running" : "paused",
              } as CSSProperties
            }
            initial={{ opacity: 1 }}
            exit={{ opacity: 0 }}
            transition={{ duration: 0.14 }}
          >
            <PetalGlassSweep petal={hoverPetal} />
          </motion.div>
        )}
      </AnimatePresence>
    </>
  )
}

function PetalGlassSweep({ petal }: { petal: (typeof PETALS)[number] }) {
  const uid = useId().replace(/:/g, "")
  const centerX = (Number.parseFloat(petal.artLeft) + 15.955) * 7.5
  const centerY = (Number.parseFloat(petal.artTop) + 17.55) * 7.5
  const pose = `translate(${centerX} ${centerY}) rotate(${petal.rotation}) translate(-219.662 -231.628)`
  const labelX = Number.parseFloat(petal.labelLeft) * 7.5
  const labelY = (Number.parseFloat(petal.labelTop) + 8) * 7.5

  return (
    <svg
      className={styles.glassSweep}
      viewBox="0 0 750 750"
      preserveAspectRatio="none"
      data-glass-direction="outer-to-center"
    >
      <defs>
        <clipPath id={`${uid}-petal`}>
          <path d={PETAL_CONTOUR} transform={pose} />
        </clipPath>
        <radialGradient id={`${uid}-lens`}>
          <stop offset="0%" stopColor="white" />
          <stop offset="45%" stopColor="white" stopOpacity="0.96" />
          <stop offset="100%" stopColor="white" stopOpacity="0" />
        </radialGradient>
        <radialGradient id={`${uid}-label-shield`}>
          <stop offset="68%" stopColor="black" />
          <stop offset="100%" stopColor="black" stopOpacity="0" />
        </radialGradient>
        <linearGradient id={`${uid}-shine`}>
          <stop offset="0%" stopColor="#b4e0ff" stopOpacity="0" />
          <stop offset="25%" stopColor="#d7eeff" stopOpacity="0.4" />
          <stop offset="48%" stopColor="#f6fcff" stopOpacity="0.82" />
          <stop offset="72%" stopColor="#c4dbff" stopOpacity="0.36" />
          <stop offset="100%" stopColor="#b4e0ff" stopOpacity="0" />
        </linearGradient>
        <mask
          id={`${uid}-moving-lens`}
          x="0"
          y="0"
          width="750"
          height="750"
          maskUnits="userSpaceOnUse"
          style={{ maskType: "luminance" }}
        >
          <g transform={pose}>
            <ellipse
              className={styles.glassTravel}
              cx="219.662"
              cy="90"
              rx="155"
              ry="48"
              fill={`url(#${uid}-lens)`}
            />
          </g>
          <ellipse
            cx={labelX}
            cy={labelY}
            rx="74"
            ry="68"
            fill={`url(#${uid}-label-shield)`}
          />
        </mask>
        <filter
          id={`${uid}-refraction`}
          x="0"
          y="0"
          width="750"
          height="750"
          filterUnits="userSpaceOnUse"
          colorInterpolationFilters="sRGB"
        >
          <feTurbulence
            type="fractalNoise"
            baseFrequency="0.007 0.019"
            numOctaves="1"
            seed="9"
            result="curve"
          />
          <feGaussianBlur in="curve" stdDeviation="6" result="smoothCurve" />
          <feDisplacementMap
            in="SourceGraphic"
            in2="smoothCurve"
            scale="20"
            xChannelSelector="R"
            yChannelSelector="G"
          />
        </filter>
        <filter
          id={`${uid}-soften`}
          x="-30%"
          y="-100%"
          width="160%"
          height="300%"
        >
          <feGaussianBlur stdDeviation="5" />
        </filter>
      </defs>
      <g clipPath={`url(#${uid}-petal)`}>
        <g mask={`url(#${uid}-moving-lens)`}>
          <image
            className={styles.glassRefraction}
            href={SCREEN}
            x="0"
            y="-362.055"
            width="750"
            height="1611.99825"
            preserveAspectRatio="none"
            filter={`url(#${uid}-refraction)`}
          />
        </g>
        <g transform={pose}>
          <g className={styles.glassTravel}>
            <g className={styles.glassShine} fill="none" strokeLinecap="round">
              <path
                d="M65 88 Q219.662 150 374.324 88"
                stroke="#31547d"
                strokeOpacity="0.12"
                strokeWidth="24"
                filter={`url(#${uid}-soften)`}
              />
              <path
                d="M65 72 Q219.662 128 374.324 72"
                stroke={`url(#${uid}-shine)`}
                strokeWidth="27"
                filter={`url(#${uid}-soften)`}
              />
              <path
                d="M65 74 Q219.662 130 374.324 74"
                stroke={`url(#${uid}-shine)`}
                strokeWidth="4.5"
                strokeOpacity="0.55"
                filter={`url(#${uid}-soften)`}
              />
            </g>
          </g>
        </g>
      </g>
    </svg>
  )
}

function PetalArtwork({
  petal,
  highlighted,
  reduceMotion,
}: {
  petal: (typeof PETALS)[number]
  highlighted: boolean
  reduceMotion: boolean
}) {
  return (
    <div
      className="absolute"
      style={{
        left: petal.artLeft,
        top: petal.artTop,
        width: "31.91%",
        height: "35.1%",
        transform: `rotate(${petal.rotation}deg)`,
        transformOrigin: "50% 50%",
      }}
    >
      <div className="absolute" style={{ inset: "-37.99% -41.78%" }}>
        <motion.img
          src={PETAL_SHELL}
          alt=""
          className="absolute inset-0 block h-full w-full max-w-none"
          draggable={false}
          animate={{
            opacity: highlighted ? 0.56 : 0,
            filter: highlighted
              ? "brightness(1.08) drop-shadow(0 1px 4px rgba(255, 255, 255, 0.18))"
              : "brightness(1)",
          }}
          transition={{ duration: reduceMotion ? 0 : 0.18, ease: EASE }}
        />
      </div>
    </div>
  )
}

function CapabilitySheet({
  petal,
  reduceMotion,
  origin,
  onClose,
}: {
  petal: (typeof PETALS)[number]
  reduceMotion: boolean
  origin: PetalOrigin
  onClose: () => void
}) {
  const [draft, setDraft] = useState(() => PANEL_DRAFTS[petal.id])
  const [activeChoice, setActiveChoice] = useState(() => {
    if (petal.id === "code") return "网页"
    if (petal.id === "call") return "预约"
    if (petal.id === "write") return "文章"
    if (petal.id === "document") return "总结"
    return ""
  })
  const closeButtonRef = useRef<HTMLButtonElement>(null)
  const isKnowledge = petal.id === "knowledge"
  const cardHeight = PANEL_CARD_HEIGHT[petal.id]
  const referenceKind =
    petal.id === "write" || petal.id === "document" || petal.id === "translate"
      ? petal.id
      : null
  const heightRatio = Number.parseFloat(cardHeight) / 100
  // Use local layout dimensions so the origin stays accurate inside the scaled slide.
  const collapsed = {
    x: origin.x - origin.width * 0.5,
    y:
      origin.y -
      (origin.height * 0.235 + origin.width * (0.042 + heightRatio / 2)),
    scaleX: 0.28 / 0.936,
    scaleY: 0.32 / heightRatio,
    borderRadius: "42cqw",
    opacity: 0,
  }

  useEffect(() => {
    const frame = window.requestAnimationFrame(() => {
      closeButtonRef.current?.focus({ preventScroll: true })
    })
    return () => window.cancelAnimationFrame(frame)
  }, [])

  return (
    <motion.section
      role="dialog"
      aria-modal="true"
      aria-label={petal.label + "浮层"}
      className="absolute inset-0 z-20"
      style={{ color: "#263b4f" }}
      initial="closed"
      animate="open"
      exit="closed"
      onKeyDown={(event) => {
        if (event.key !== "Tab") return
        const buttons = event.currentTarget.querySelectorAll<HTMLElement>(
          "button:not([disabled]), textarea:not([disabled]), select:not([disabled])"
        )
        const first = buttons[0]
        const last = buttons[buttons.length - 1]
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault()
          last?.focus()
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault()
          first?.focus()
        }
      }}
    >
      <motion.div
        aria-hidden="true"
        className="absolute inset-x-0 bottom-0"
        onClick={onClose}
        style={{
          top: "23.5%",
          borderRadius: "6cqw 6cqw 0 0",
          background:
            "linear-gradient(180deg, rgba(255,255,255,0.985), rgba(244,248,252,0.97) 54%, rgba(205,220,234,0.94))",
          backdropFilter: "blur(4cqw) saturate(1.08)",
          WebkitBackdropFilter: "blur(4cqw) saturate(1.08)",
          boxShadow:
            "0 -2.2cqw 8cqw rgba(35,62,91,0.11), 0 0.2cqw 0 rgba(255,255,255,0.95) inset",
        }}
        variants={{
          open: {
            opacity: 1,
            transition: { duration: reduceMotion ? 0 : 0.22 },
          },
          closed: {
            opacity: 0,
            transition: { duration: reduceMotion ? 0 : 0.22 },
          },
        }}
      />

      <motion.div
        className="absolute right-[3.2cqw] left-[3.2cqw] overflow-hidden"
        data-petal-sheet={petal.id}
        style={{
          top: "calc(23.5% + 4.2cqw)",
          height: cardHeight,
          transformOrigin: "50% 50%",
          background:
            "radial-gradient(ellipse at 8% 0%, rgba(255,255,255,0.98), transparent 62%), linear-gradient(145deg, rgba(255,255,255,0.985), rgba(238,247,255,0.96) 64%, rgba(248,250,255,0.985))",
          border: "0.28cqw solid rgba(103,88,255,0.84)",
          boxShadow:
            "0 3.2cqw 10cqw rgba(41,62,89,0.15), 0 1cqw 3cqw rgba(55,86,123,0.06), 0 0 0 0.14cqw rgba(100,232,232,0.12) inset",
          backdropFilter: "blur(5cqw) saturate(1.08)",
          WebkitBackdropFilter: "blur(5cqw) saturate(1.08)",
          ...(referenceKind
            ? {
                background: "transparent",
                border: 0,
                boxShadow: "none",
                backdropFilter: "none",
                WebkitBackdropFilter: "none",
              }
            : {}),
        }}
        variants={{
          open: {
            x: 0,
            y: 0,
            scaleX: 1,
            scaleY: 1,
            borderRadius: referenceKind ? "3.2cqw" : "5.8cqw",
            opacity: 1,
            transition: { duration: reduceMotion ? 0 : 0.28, ease: EASE },
          },
          closed: reduceMotion
            ? { opacity: 0, transition: { duration: 0 } }
            : {
                ...collapsed,
                transition: { duration: 0.24, ease: [0.4, 0, 0.2, 1] },
              },
        }}
      >
        <motion.div
          className="flex h-full min-h-0 flex-col"
          variants={{
            open: {
              opacity: 1,
              transition: {
                duration: reduceMotion ? 0 : 0.14,
                delay: reduceMotion ? 0 : 0.12,
              },
            },
            closed: {
              opacity: 0,
              transition: { duration: reduceMotion ? 0 : 0.08 },
            },
          }}
        >
          {referenceKind ? (
            <XinliuReferencePanel
              kind={referenceKind}
              // Reference panels use their own container, 93.6% of the phone width.
              inputHeight={`${PANEL_INPUT_HEIGHT / 0.936}cqw`}
              onClose={onClose}
              closeButtonRef={closeButtonRef}
            />
          ) : (
            <>
              <header
                className="relative grid shrink-0 place-items-center"
                style={{
                  height: "14.8cqw",
                  background:
                    "linear-gradient(180deg, rgba(255,255,255,0.36), rgba(247,251,255,0.06))",
                  borderBottom: "0.18cqw solid rgba(118,150,178,0.14)",
                  boxShadow: "0 0.2cqw 0 rgba(255,255,255,0.45)",
                }}
              >
                <button
                  ref={closeButtonRef}
                  type="button"
                  onClick={onClose}
                  aria-label="关闭能力浮层"
                  className={`absolute ${isKnowledge ? "right-[2.6cqw] focus-visible:outline-[#1c1c1e]" : "left-[2.6cqw] focus-visible:outline-[#6c91b0]"} grid cursor-pointer place-items-center rounded-full p-0 focus-visible:outline-2 focus-visible:outline-offset-2`}
                  style={{
                    width: "8.8cqw",
                    height: "8.8cqw",
                    color: isKnowledge ? "#1c1c1e" : "#526e86",
                    background: isKnowledge
                      ? "transparent"
                      : "rgba(255,255,255,0.42)",
                    border: isKnowledge
                      ? "0.18cqw solid transparent"
                      : "0.18cqw solid rgba(255,255,255,0.78)",
                    boxShadow: isKnowledge
                      ? "none"
                      : "0 0.4cqw 1.5cqw rgba(66,99,129,0.05)",
                  }}
                >
                  <X
                    style={{ width: "4.4cqw", height: "4.4cqw" }}
                    strokeWidth={1.7}
                  />
                </button>
                <h2
                  className="relative m-0"
                  style={{
                    color: "#233448",
                    fontFamily: "'PingFang SC', sans-serif",
                    fontSize: "5.2cqw",
                    fontWeight: 600,
                    lineHeight: 1.2,
                    letterSpacing: "-0.02em",
                  }}
                >
                  <span className="relative z-[1]">
                    {getPanelTitle(petal.id)}
                  </span>
                  <span
                    aria-hidden="true"
                    className="absolute right-[-0.9cqw] bottom-[-0.55cqw] left-[-0.9cqw] h-[1.6cqw] rounded-full"
                    style={{
                      background:
                        "linear-gradient(90deg, rgba(205,92,229,0.82), rgba(94,232,232,0.9))",
                      transform: "rotate(-1.5deg)",
                    }}
                  />
                </h2>
                {!isKnowledge && (
                  <span
                    aria-hidden="true"
                    className="absolute right-[4cqw] grid place-items-center rounded-[2.5cqw]"
                    style={{
                      width: "7cqw",
                      height: "7cqw",
                      background:
                        "linear-gradient(145deg, rgba(255,255,255,0.85), rgba(186,209,230,0.38))",
                      border: "0.18cqw solid rgba(255,255,255,0.8)",
                      boxShadow: "0 0.5cqw 1.8cqw rgba(82,117,149,0.08)",
                    }}
                  >
                    <img
                      src={petal.icon}
                      alt=""
                      style={{
                        width: "4.3cqw",
                        height: "4.3cqw",
                        filter:
                          "brightness(0) saturate(100%) invert(43%) sepia(13%) saturate(1129%) hue-rotate(166deg) brightness(91%) contrast(86%)",
                      }}
                    />
                  </span>
                )}
              </header>
              <div
                className="flex min-h-0 flex-1 flex-col overflow-y-auto"
                style={{ padding: "3.5cqw" }}
              >
                <ToolPanel
                  petalId={petal.id}
                  draft={draft}
                  activeChoice={activeChoice}
                  onDraftChange={setDraft}
                  onChoiceChange={setActiveChoice}
                />
              </div>
            </>
          )}
        </motion.div>
      </motion.div>

      <MobileKeyboard
        reduceMotion={reduceMotion}
        top={`calc(23.5% + 4.2cqw + ${cardHeight} + 3.2cqw)`}
      />
    </motion.section>
  )
}

function MobileKeyboard({
  reduceMotion,
  top,
}: {
  reduceMotion: boolean
  top: string
}) {
  const rows = [
    ["q", "w", "e", "r", "t", "y", "u", "i", "o", "p"],
    ["a", "s", "d", "f", "g", "h", "j", "k", "l"],
    ["⇧", "z", "x", "c", "v", "b", "n", "m", "⌫"],
  ]

  return (
    <motion.div
      aria-hidden="true"
      className="pointer-events-none absolute inset-x-0 bottom-0 overflow-hidden"
      style={{
        top,
        color: "#344e66",
        background:
          "linear-gradient(180deg, rgba(222,236,249,0.6), rgba(180,204,228,0.78))",
        borderTop: "0.18cqw solid rgba(255,255,255,0.65)",
        borderRadius: "4cqw 4cqw 0 0",
        backdropFilter: "blur(6cqw)",
        WebkitBackdropFilter: "blur(6cqw)",
        boxShadow: "0 -1cqw 5cqw rgba(49,79,112,0.06)",
      }}
      variants={{
        open: {
          opacity: 1,
          y: 0,
          transition: {
            duration: reduceMotion ? 0 : 0.18,
            delay: reduceMotion ? 0 : 0.1,
            ease: EASE,
          },
        },
        closed: {
          opacity: 0,
          y: reduceMotion ? 0 : "3cqw",
          transition: { duration: reduceMotion ? 0 : 0.14 },
        },
      }}
    >
      <div
        className="absolute inset-x-0 bottom-0 flex flex-col"
        style={{ height: "min(72cqw, 100%)", padding: "1.8cqw 1.8cqw 1cqw" }}
      >
        <div
          className="mb-[1.1cqw] grid grid-cols-3 items-center text-center"
          style={{
            height: "6.8cqw",
            color: "#536e86",
            fontFamily: "-apple-system, BlinkMacSystemFont, sans-serif",
            fontSize: "3cqw",
          }}
        >
          <span>「</span>
          <span>心流</span>
          <span>完成</span>
        </div>

        <div className="flex min-h-0 flex-1 flex-col gap-[1cqw]">
          {rows.map((row, rowIndex) => (
            <div
              key={row.join("")}
              className="flex min-h-0 flex-1 justify-center gap-[1cqw]"
              style={{ paddingInline: rowIndex === 1 ? "4.2cqw" : 0 }}
            >
              {row.map((key) => {
                const isUtility = key === "⇧" || key === "⌫"

                return (
                  <span
                    key={key}
                    className="grid min-w-0 flex-1 place-items-center rounded-[1.35cqw]"
                    style={{
                      maxWidth: isUtility ? "10.4cqw" : "8.5cqw",
                      background: isUtility
                        ? "rgba(166,192,216,0.52)"
                        : "rgba(250,253,255,0.76)",
                      boxShadow:
                        "0 0.35cqw 0.5cqw rgba(73,104,133,0.2), 0 0.18cqw 0 rgba(255,255,255,0.8) inset",
                      fontFamily:
                        "-apple-system, BlinkMacSystemFont, sans-serif",
                      fontSize: isUtility ? "3.5cqw" : "3.9cqw",
                      lineHeight: 1,
                    }}
                  >
                    {key}
                  </span>
                )
              })}
            </div>
          ))}
        </div>

        <div className="mt-[1.2cqw] flex h-[9cqw] gap-[1.2cqw]">
          {[
            { label: "123", grow: 0.78 },
            { label: "空格", grow: 2.7 },
            { label: "换行", grow: 1 },
          ].map((key) => (
            <span
              key={key.label}
              className="grid min-w-0 place-items-center rounded-[1.4cqw]"
              style={{
                flex: key.grow,
                background:
                  key.label === "空格"
                    ? "rgba(250,253,255,0.76)"
                    : "rgba(166,192,216,0.52)",
                boxShadow:
                  "0 0.35cqw 0.5cqw rgba(73,104,133,0.2), 0 0.18cqw 0 rgba(255,255,255,0.8) inset",
                fontFamily: "-apple-system, BlinkMacSystemFont, sans-serif",
                fontSize: "3.1cqw",
              }}
            >
              {key.label}
            </span>
          ))}
        </div>

        <div className="relative mt-[1cqw] flex h-[7.2cqw] items-start justify-between px-[5cqw] pt-[0.8cqw]">
          <span style={{ fontSize: "4cqw", lineHeight: 1 }}>◎</span>
          <Mic
            style={{ width: "4.2cqw", height: "4.2cqw" }}
            strokeWidth={1.7}
          />
          <span
            className="absolute bottom-[0.4cqw] left-1/2 h-[0.9cqw] w-[34cqw] -translate-x-1/2 rounded-full"
            style={{ background: "rgba(45,68,91,0.7)" }}
          />
        </div>
      </div>
    </motion.div>
  )
}

function getPanelTitle(petalId: PetalId) {
  const titles: Record<PetalId, string> = {
    code: "代码生成",
    translate: "一键翻译",
    call: "打电话",
    write: "场景写作",
    document: "读文档",
    knowledge: "知识库",
  }

  return titles[petalId]
}

function ToolPanel({
  petalId,
  draft,
  activeChoice,
  onDraftChange,
  onChoiceChange,
}: {
  petalId: PetalId
  draft: string
  activeChoice: string
  onDraftChange: (value: string) => void
  onChoiceChange: (value: string) => void
}) {
  if (petalId === "knowledge") {
    const recommendations = ["找到项目最新结论", "对比两版方案差异"]

    return (
      <div className="flex min-h-0 flex-1 flex-col">
        <div className="flex gap-[1.7cqw]">
          {["知识范围", "时间范围", "引用来源"].map((field) => (
            <SelectPill key={field} label={field} className="flex-1" compact />
          ))}
        </div>

        <PanelLabel className="mt-[3.2cqw]">试试这样问</PanelLabel>
        <div className="mt-[1.8cqw] flex flex-col gap-[1.2cqw]">
          {recommendations.map((recommendation) => (
            <button
              key={recommendation}
              type="button"
              onClick={() => onDraftChange(recommendation)}
              className="flex cursor-pointer items-center gap-[2cqw] rounded-[2.5cqw] border-0 text-left"
              style={{
                minHeight: "7.5cqw",
                padding: "1.2cqw 2cqw",
                color: "#45627a",
                background: "rgba(248,252,255,0.54)",
                boxShadow: "0 0.2cqw 0 rgba(255,255,255,0.9) inset",
                fontFamily: "'PingFang SC', sans-serif",
                fontSize: "3.15cqw",
              }}
            >
              <Search
                className="shrink-0"
                style={{ width: "3.5cqw", height: "3.5cqw" }}
                strokeWidth={1.9}
              />
              <span className="min-w-0 flex-1 truncate">{recommendation}</span>
              <ChevronRight
                className="shrink-0"
                style={{ width: "3.4cqw", height: "3.4cqw" }}
                strokeWidth={1.7}
              />
            </button>
          ))}
        </div>

        <Composer
          className="mt-[2.5cqw]"
          value={draft}
          placeholder="基于我的资料提问"
          sendTone="black"
          sourceLabel="项目知识库"
          sourceIcon={
            <Search
              style={{ width: "4cqw", height: "4cqw" }}
              strokeWidth={1.8}
            />
          }
          onChange={onDraftChange}
        />
      </div>
    )
  }

  if (petalId === "call") {
    return (
      <ConfigurationPanel
        activeChoice={activeChoice}
        choices={["预约", "咨询", "改签", "其他"]}
        fields={["通话语言", "沟通语气", "结果记录"]}
        draft={draft}
        placeholder="说明代办事项，例如：预约今晚 7 点两人位"
        sourceLabel="联系人"
        sourceIcon={
          <Phone style={{ width: "4cqw", height: "4cqw" }} strokeWidth={1.8} />
        }
        onChoiceChange={onChoiceChange}
        onDraftChange={onDraftChange}
        leading={
          <>
            <PanelLabel>对象</PanelLabel>
            <button
              type="button"
              className="mt-[1.7cqw] flex w-full cursor-pointer items-center gap-[2cqw] rounded-[2.6cqw] text-left"
              style={{
                minHeight: "9.5cqw",
                padding: "1.8cqw 2.4cqw",
                color: "#637d93",
                background:
                  "linear-gradient(150deg, rgba(252,254,255,0.74), rgba(231,242,251,0.46))",
                border: "0.18cqw solid rgba(255,255,255,0.85)",
                fontFamily: "'PingFang SC', sans-serif",
                fontSize: "3.2cqw",
              }}
            >
              <Phone
                style={{ width: "3.8cqw", height: "3.8cqw" }}
                strokeWidth={1.8}
              />
              <span className="flex-1">选择联系人或输入号码</span>
              <ChevronRight
                style={{ width: "3.8cqw", height: "3.8cqw" }}
                strokeWidth={1.6}
              />
            </button>
          </>
        }
        typeLabel="任务"
        dense
      />
    )
  }

  return (
    <ConfigurationPanel
      activeChoice={activeChoice}
      choices={["网页", "小程序", "脚本", "数据处理"]}
      fields={["技术栈", "运行环境", "输出方式"]}
      draft={draft}
      placeholder="描述想实现的功能，例如：生成一个带登录和筛选的后台页面"
      sourceLabel="参考文件"
      sourceIcon={
        <Paperclip
          style={{ width: "4cqw", height: "4cqw" }}
          strokeWidth={1.8}
        />
      }
      onChoiceChange={onChoiceChange}
      onDraftChange={onDraftChange}
      typeLabel="类型"
    />
  )
}

function ConfigurationPanel({
  activeChoice,
  choices,
  fields,
  draft,
  placeholder,
  sourceLabel,
  sourceIcon,
  typeLabel,
  leading,
  dense = false,
  onChoiceChange,
  onDraftChange,
}: {
  activeChoice: string
  choices: readonly string[]
  fields: readonly string[]
  draft: string
  placeholder: string
  sourceLabel: string
  sourceIcon: ReactNode
  typeLabel: string
  leading?: ReactNode
  dense?: boolean
  onChoiceChange: (value: string) => void
  onDraftChange: (value: string) => void
}) {
  return (
    <div className="flex min-h-0 flex-1 flex-col">
      {leading}

      <PanelLabel className={leading ? "mt-[2.5cqw]" : undefined}>
        {typeLabel}
      </PanelLabel>
      <ChoiceChips
        className="mt-[1.7cqw]"
        choices={choices}
        activeChoice={activeChoice}
        onChange={onChoiceChange}
        compact={dense}
      />

      <PanelLabel className={dense ? "mt-[2.2cqw]" : "mt-[3.4cqw]"}>
        要求
      </PanelLabel>
      <div className="mt-[1.7cqw] flex gap-[1.8cqw]">
        {fields.map((field) => (
          <SelectPill key={field} label={field} className="flex-1" compact />
        ))}
      </div>

      <Composer
        className={dense ? "mt-[2.2cqw]" : "mt-[3.2cqw]"}
        value={draft}
        placeholder={placeholder}
        sourceLabel={sourceLabel}
        sourceIcon={sourceIcon}
        onChange={onDraftChange}
      />
    </div>
  )
}

function PanelLabel({
  children,
  className,
}: {
  children: ReactNode
  className?: string
}) {
  return (
    <span
      className={className}
      style={{
        color: "#65788a",
        fontFamily: "'PingFang SC', sans-serif",
        fontSize: "3.25cqw",
        lineHeight: 1.2,
      }}
    >
      {children}
    </span>
  )
}

function ChoiceChips({
  choices,
  activeChoice,
  onChange,
  className,
  compact = false,
}: {
  choices: readonly string[]
  activeChoice: string
  onChange: (value: string) => void
  className?: string
  compact?: boolean
}) {
  return (
    <div
      className={[
        "flex min-w-0 gap-[1.6cqw] overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden",
        className ?? "",
      ].join(" ")}
    >
      {choices.map((choice) => {
        const selected = activeChoice === choice

        return (
          <button
            key={choice}
            type="button"
            aria-pressed={selected}
            onClick={() => onChange(choice)}
            className="shrink-0 cursor-pointer rounded-[2.4cqw] whitespace-nowrap"
            style={{
              minHeight: compact ? "7.6cqw" : "8.4cqw",
              padding: compact ? "1.3cqw 2.2cqw" : "1.5cqw 2.7cqw",
              color: selected ? "#365d7d" : "#4e657a",
              background: selected
                ? "linear-gradient(145deg, rgba(215,232,246,0.96), rgba(187,213,235,0.7))"
                : "rgba(249,253,255,0.48)",
              border: selected
                ? "0.18cqw solid rgba(134,174,207,0.4)"
                : "0.18cqw solid rgba(255,255,255,0.84)",
              fontFamily: "'PingFang SC', sans-serif",
              fontSize: compact ? "3.15cqw" : "3.3cqw",
              fontWeight: selected ? 600 : 450,
            }}
          >
            {choice}
          </button>
        )
      })}
    </div>
  )
}

function SelectPill({
  label,
  className,
  compact = false,
}: {
  label: string
  className?: string
  compact?: boolean
}) {
  return (
    <button
      type="button"
      className={[
        "flex min-w-0 cursor-pointer items-center rounded-[2.4cqw] whitespace-nowrap",
        className ?? "",
      ].join(" ")}
      style={{
        minHeight: compact ? "7.6cqw" : "9.4cqw",
        padding: compact ? "1.2cqw 1.8cqw" : "1.5cqw 2.8cqw",
        color: "#456079",
        background:
          "linear-gradient(150deg, rgba(252,254,255,0.74), rgba(231,242,251,0.46))",
        border: "0.18cqw solid rgba(255,255,255,0.85)",
        boxShadow: "0 0.4cqw 1.5cqw rgba(68,101,133,0.035)",
        fontFamily: "'PingFang SC', sans-serif",
        fontSize: compact ? "3.15cqw" : "3.4cqw",
      }}
    >
      <span className="min-w-0 flex-1 truncate">{label}</span>
      <ChevronDown
        className="ml-[1cqw] shrink-0"
        style={{ width: "3cqw", height: "3cqw" }}
        strokeWidth={2}
      />
    </button>
  )
}

function Composer({
  value,
  placeholder,
  sourceLabel,
  sourceIcon,
  className,
  sendTone = "glass",
  onChange,
}: {
  value: string
  placeholder: string
  sourceLabel: string
  sourceIcon: ReactNode
  className?: string
  sendTone?: "glass" | "black"
  onChange: (value: string) => void
}) {
  const hasContent = value.trim().length > 0

  return (
    <div
      className={[
        "flex shrink-0 flex-col rounded-[3cqw]",
        className ?? "",
      ].join(" ")}
      style={{
        padding: "2.4cqw 2.2cqw 1.8cqw",
        background:
          "linear-gradient(145deg, rgba(252,254,255,0.82), rgba(241,248,254,0.58))",
        border: "0.18cqw solid rgba(255,255,255,0.94)",
        boxShadow:
          "0 0.5cqw 2cqw rgba(60,97,134,0.04) inset, 0 0.5cqw 2.5cqw rgba(60,97,134,0.025)",
      }}
    >
      <textarea
        value={value}
        onChange={(event) => onChange(event.target.value)}
        aria-label="工具需求输入"
        placeholder={placeholder}
        className="shrink-0 resize-none overflow-y-auto border-0 bg-transparent p-0 outline-none placeholder:text-[#7c91a4]"
        style={{
          height: `${PANEL_INPUT_HEIGHT}cqw`,
          color: "#263b4f",
          fontFamily: "'PingFang SC', sans-serif",
          fontSize: "3.5cqw",
          lineHeight: 1.58,
          caretColor: "#527fa3",
        }}
      />

      <div className="mt-[1.5cqw] flex items-center justify-between gap-[2cqw]">
        <button
          type="button"
          className="flex min-w-0 cursor-pointer items-center gap-[1.2cqw] rounded-full border-0 bg-transparent p-0"
          style={{ color: "#58738b" }}
        >
          <span className="grid shrink-0 place-items-center" aria-hidden="true">
            {sourceIcon}
          </span>
          <span
            className="truncate"
            style={{
              fontFamily: "'PingFang SC', sans-serif",
              fontSize: "3.15cqw",
            }}
          >
            {sourceLabel}
          </span>
        </button>

        <div className="flex shrink-0 items-center gap-[1.3cqw]">
          <button
            type="button"
            aria-label="语音输入"
            className="grid cursor-pointer place-items-center rounded-full border-0 bg-transparent p-0"
            style={{
              width: "10cqw",
              height: "10cqw",
              color: "#456984",
            }}
          >
            <Mic
              style={{ width: "4.8cqw", height: "4.8cqw" }}
              strokeWidth={1.75}
            />
          </button>
          <button
            type="button"
            aria-label="发送"
            disabled={!hasContent}
            className="grid place-items-center rounded-full border-0 p-0"
            style={{
              width: "10cqw",
              height: "10cqw",
              color: hasContent ? "white" : "rgba(82,89,101,0.32)",
              background: hasContent
                ? sendTone === "black"
                  ? "#1c1c1e"
                  : "linear-gradient(145deg, #91b6d3 0%, #6189ac 58%, #527695 100%)"
                : sendTone === "black"
                  ? "rgba(28,28,30,0.08)"
                  : "rgba(195,216,232,0.35)",
              boxShadow: hasContent
                ? sendTone === "black"
                  ? "0 0.6cqw 1.6cqw rgba(0,0,0,0.12), 0 0.18cqw 0.35cqw rgba(255,255,255,0.12) inset"
                  : "0 1cqw 2.5cqw rgba(70,107,140,0.2), 0 0.3cqw 0.6cqw rgba(255,255,255,0.48) inset"
                : "none",
              cursor: hasContent ? "pointer" : "default",
            }}
          >
            <Send
              style={{ width: "3.8cqw", height: "3.8cqw" }}
              strokeWidth={1.9}
            />
          </button>
        </div>
      </div>
    </div>
  )
}
