.ambientLight,
.capabilityLight,
.hoverLight {
  position: absolute;
  z-index: 2;
  inset-inline: 0;
  top: 22.46%;
  height: 46.5261%;
  pointer-events: none;
}

.ambientLight {
  mix-blend-mode: soft-light;
}

.capabilityLight,
.hoverLight {
  mix-blend-mode: screen;
}

.lightField {
  position: absolute;
  inset: -3%;
  overflow: hidden;
  mask-image: radial-gradient(
    ellipse 49% 48% at 50% 49%,
    #000 48%,
    #000c 72%,
    transparent 100%
  );
  -webkit-mask-image: radial-gradient(
    ellipse 49% 48% at 50% 49%,
    #000 48%,
    #000c 72%,
    transparent 100%
  );
}

.lightRiver,
.shadowRiver,
.warmReflection {
  position: absolute;
  inset: -25%;
  will-change: transform;
  animation-play-state: var(--light-play-state);
}

.lightRiver {
  background:
    radial-gradient(
      ellipse 25% 42% at 30% 38%,
      rgb(227 247 255 / 80%),
      transparent 78%
    ),
    radial-gradient(
      ellipse 32% 18% at 68% 68%,
      rgb(248 252 255 / 65%),
      transparent 82%
    );
  animation: light-drift 16s ease-in-out infinite;
  animation-play-state: var(--light-play-state);
}

.shadowRiver {
  background:
    radial-gradient(
      ellipse 22% 34% at 65% 38%,
      rgb(35 65 106 / 42%),
      transparent 85%
    ),
    radial-gradient(
      ellipse 32% 21% at 34% 64%,
      rgb(59 91 137 / 28%),
      transparent 80%
    );
  animation: shadow-drift 16s ease-in-out infinite;
  animation-play-state: var(--light-play-state);
}

.warmReflection {
  background: radial-gradient(
    ellipse 23% 35% at 66% 37%,
    rgb(255 221 196 / 38%),
    transparent 78%
  );
  animation: warm-drift 22s ease-in-out infinite;
  animation-play-state: var(--light-play-state);
}

.petalLight,
.sweepPetal {
  position: absolute;
  width: 31.91%;
  height: 35.1%;
  transform-origin: 50% 50%;
}

.petalMask {
  position: absolute;
  inset: -37.99% -41.78%;
  mask: url("/images/page7/figma-home/petal-light-mask.svg") center / 100% 100%
    no-repeat;
  -webkit-mask: url("/images/page7/figma-home/petal-light-mask.svg") center /
    100% 100% no-repeat;
}

.surfaceLight,
.surfaceShade {
  position: absolute;
  inset: 0;
  will-change: transform;
}

.surfaceLight {
  background:
    radial-gradient(
      ellipse 17% 42% at 35% 42%,
      rgb(244 252 255 / 85%),
      transparent 80%
    ),
    radial-gradient(
      ellipse 23% 14% at 63% 27%,
      rgb(233 248 255 / 60%),
      transparent 85%
    );
  animation: petal-refraction 12s ease-in-out infinite;
  animation-delay: var(--light-phase);
  animation-play-state: var(--light-play-state);
}

.capabilityStep {
  position: absolute;
  inset: 0;
}

.edgeArtwork {
  position: absolute;
  inset: -37.99% -41.78%;
}

.edgeSvg {
  display: block;
  width: 100%;
  height: 100%;
  overflow: visible;
}

.edgeTrail,
.edgeCore,
.edgeTip {
  opacity: 0;
  animation: edge-orbit 12s linear infinite;
  animation-delay: var(--sweep-phase);
  animation-play-state: var(--light-play-state);
}

.edgeTrail {
  stroke: rgb(154 214 255 / 32%);
  stroke-width: 9;
  stroke-dasharray: 25 75;
}

.edgeCore {
  stroke: rgb(214 241 255 / 90%);
  stroke-width: 3.2;
  stroke-dasharray: 14 86;
  animation-name: edge-core-orbit;
}

.edgeTip {
  stroke: rgb(255 255 255 / 96%);
  stroke-width: 4;
  stroke-dasharray: 2 98;
  animation-name: edge-tip-orbit;
}

/* One short glint traces the true outline, then hands off to the next petal. */
@keyframes edge-orbit {
  0% {
    opacity: 0;
    stroke-dashoffset: 0;
  }
  2%,
  13% {
    opacity: 1;
  }
  16.6667%,
  100% {
    opacity: 0;
    stroke-dashoffset: -100;
  }
}

@keyframes edge-core-orbit {
  0% {
    opacity: 0;
    stroke-dashoffset: -10;
  }
  2%,
  13% {
    opacity: 1;
  }
  16.6667%,
  100% {
    opacity: 0;
    stroke-dashoffset: -110;
  }
}

@keyframes edge-tip-orbit {
  0% {
    opacity: 0;
    stroke-dashoffset: -23;
  }
  2%,
  13% {
    opacity: 1;
  }
  16.6667%,
  100% {
    opacity: 0;
    stroke-dashoffset: -123;
  }
}

.sweepBloom,
.sweepBeam {
  position: absolute;
  inset: 0;
  opacity: 0;
}

.sweepBloom {
  background:
    radial-gradient(
      ellipse 26% 31% at 50% 42%,
      rgb(212 239 255 / 72%) 12%,
      rgb(124 184 255 / 38%) 58%,
      transparent 100%
    ),
    linear-gradient(
      155deg,
      transparent 25%,
      rgb(172 219 255 / 28%) 55%,
      transparent 76%
    );
  animation: hover-bloom 1.65s ease-in-out both;
  animation-play-state: var(--light-play-state);
}

.sweepBeam {
  background: linear-gradient(
    165deg,
    transparent 34%,
    rgb(151 210 255 / 8%) 40%,
    rgb(208 238 255 / 62%) 46%,
    rgb(255 255 255 / 96%) 49.5%,
    rgb(234 246 255 / 70%) 52%,
    rgb(172 197 255 / 24%) 58%,
    transparent 66%
  );
  will-change: transform, opacity;
  animation: hover-sweep 1.65s cubic-bezier(0.3, 0, 0.2, 1) both;
  animation-play-state: var(--light-play-state);
}

/* Surface light is reserved for a single pass on pointer entry. */
@keyframes hover-bloom {
  0%,
  100% {
    opacity: 0;
  }
  30%,
  60% {
    opacity: 0.68;
  }
}

@keyframes hover-sweep {
  0% {
    opacity: 0;
    transform: translate(-18%, 42%);
  }
  18% {
    opacity: 0.7;
  }
  42% {
    opacity: 0.92;
  }
  100% {
    opacity: 0;
    transform: translate(16%, -46%);
  }
}

.surfaceShade {
  background: radial-gradient(
    ellipse 22% 31% at 62% 52%,
    rgb(37 69 112 / 34%),
    transparent 85%
  );
  animation: petal-shadow 12s ease-in-out infinite;
  animation-delay: var(--light-phase);
  animation-play-state: var(--light-play-state);
}

/* Only light textures move; the flower silhouette and its labels stay still. */
@keyframes light-drift {
  0%,
  100% {
    transform: translate(-8%, -5%) rotate(-18deg);
  }
  35% {
    transform: translate(9%, -1%) rotate(12deg);
  }
  70% {
    transform: translate(1%, 9%) rotate(28deg);
  }
}

@keyframes shadow-drift {
  0%,
  100% {
    transform: translate(6%, 5%) rotate(16deg);
  }
  35% {
    transform: translate(-8%, 3%) rotate(-14deg);
  }
  70% {
    transform: translate(-2%, -8%) rotate(-26deg);
  }
}

@keyframes warm-drift {
  0%,
  100% {
    transform: translate(5%, -9%) rotate(-12deg);
  }
  50% {
    transform: translate(-10%, 10%) rotate(24deg);
  }
}

@keyframes petal-refraction {
  0%,
  100% {
    transform: translate(-11%, -5%) rotate(-12deg);
  }
  50% {
    transform: translate(13%, 7%) rotate(14deg);
  }
}

@keyframes petal-shadow {
  0%,
  100% {
    transform: translate(9%, 6%) rotate(10deg);
  }
  50% {
    transform: translate(-10%, -6%) rotate(-12deg);
  }
}

@media (prefers-reduced-motion: reduce) {
  .ambientLight,
  .capabilityLight,
  .hoverLight {
    display: none;
  }
  .ambientLight *,
  .capabilityLight *,
  .hoverLight * {
    animation: none;
  }
}
